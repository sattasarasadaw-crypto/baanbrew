# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจาก Firebase console
# Project settings → General → Your apps → Web app → SDK setup and configuration → Config

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# ใช้เฉพาะ npm run seed และ npm run verify-import (ไม่ถูกส่งไปหน้าเว็บ เพราะไม่ขึ้นต้นด้วย VITE_)
# ห้าม commit ไฟล์ key และห้ามวางเนื้อหา key ลงใน AI chat
FIREBASE_SERVICE_ACCOUNT=./secrets/service-account.json
