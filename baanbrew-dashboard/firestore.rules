rules_version = '2';

// Lab 3.3 · Security Rules ของ baanbrew
// หลักคิด: web config อยู่ในหน้าเว็บให้ทุกคนเห็น ใครก็ยิงตรงเข้า Firestore ได้โดยไม่ผ่านฟอร์มของเรา
// ความปลอดภัยจริงจึงอยู่ที่ไฟล์นี้ — ทุกอย่างที่ไม่ได้เขียนอนุญาตไว้ = ถูกปฏิเสธ (deny by default)
//
// เอกสาร sales ที่สร้างจากหน้าเว็บ = ฟิลด์ที่ buildSale() ใน src/lab3/saleModel.js สร้าง 14 ตัว + created_at
service cloud.firestore {
  match /databases/{database}/documents {

    // ต้องล็อกอินก่อน (ล็อกอินด้วย Google แล้ว request.auth จะไม่เป็น null)
    function signedIn() {
      return request.auth != null;
    }

    // products และ branches: ล็อกอินแล้วอ่านได้ · เขียนไม่ได้จากหน้าเว็บเลย (ข้อมูลหลักแก้ผ่านสคริปต์ seed ที่ใช้ service account เท่านั้น)
    match /products/{productId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /branches/{branchId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /sales/{saleId} {
      // ล็อกอินแล้วอ่านได้
      allow read: if signedIn();
      // ยอดขายที่บันทึกแล้วแก้ไขหรือลบไม่ได้ (ถ้าผิดให้บันทึกรายการใหม่หักล้าง ไม่แก้ย้อนหลัง)
      allow update, delete: if false;
      // สร้างได้เมื่อล็อกอิน และข้อมูลต้องผ่าน validSale ทุกเงื่อนไข
      allow create: if signedIn() && validSale(request.resource.data, database);
    }

    function validSale(d, database) {
      return
        // 1) ฟิลด์ครบและไม่มีฟิลด์เกิน: กันการแอบเพิ่มฟิลด์ เช่น discount (hasOnly) และกันฟิลด์หาย (hasAll)
        d.keys().hasAll([
          'order_id', 'datetime', 'date', 'hour', 'branch', 'product_id', 'qty', 'unit_price', 'revenue',
          'customer_id', 'payment_method', 'channel', 'source', 'created_by', 'created_at'
        ])
        && d.keys().hasOnly([
          'order_id', 'datetime', 'date', 'hour', 'branch', 'product_id', 'qty', 'unit_price', 'revenue',
          'customer_id', 'payment_method', 'channel', 'source', 'created_by', 'created_at'
        ])
        // 2) บันทึกจากหน้าเว็บเท่านั้น (source = web) และต้องเป็นของผู้ล็อกอินเอง: กันการปลอมตัวเป็นผู้ใช้อื่น
        && d.source == 'web'
        && d.created_by == request.auth.uid
        // 3) created_at ต้องเป็นเวลาของเซิร์ฟเวอร์ (serverTimestamp) ใส่เวลาเองจากเครื่องไม่ได้
        && d.created_at == request.time
        // 4) สาขาและวิธีชำระเงินต้องอยู่ในรายการที่กำหนด
        && d.branch in ['สยาม', 'สีลม', 'อารีย์', 'บางนา', 'มหาวิทยาลัย']
        && d.payment_method in ['QR พร้อมเพย์', 'บัตรเครดิต', 'เงินสด', 'LINE MAN', 'Grab']
        && d.channel in ['หน้าร้าน', 'เดลิเวอรี']
        // 5) จำนวนเป็นจำนวนเต็ม 1–20 และชั่วโมงเป็นจำนวนเต็ม 0–23 (กันค่าติดลบ ทศนิยม หรือข้อความ)
        && d.qty is int && d.qty >= 1 && d.qty <= 20
        && d.hour is int && d.hour >= 0 && d.hour <= 23
        // 6) ราคาต้องตรงกับราคาเมนูใน products (ใช้ get() อ่านเอกสารเมนู) และยอดรวม = จำนวน × ราคา
        //    กันการตั้งราคาเองเช่น ลาเต้เย็น ฿1 หรือยอดรวมที่คำนวณผิด
        && d.product_id is string
        && d.unit_price == get(/databases/$(database)/documents/products/$(d.product_id)).data.price
        && d.revenue == d.qty * d.unit_price
        // 7) รูปแบบวันที่: date = YYYY-MM-DD, datetime = YYYY-MM-DDTHH:MM:SS+07:00 และ date ต้องตรงกับส่วนวันที่ของ datetime
        && d.date is string
        && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.datetime is string
        && d.datetime.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+]07:00$')
        && d.datetime.matches('^' + d.date + 'T.*$')
        // 8) รหัสสมาชิกเป็น null (ลูกค้าทั่วไป) หรือ C ตามด้วยตัวเลข 5 หลัก
        && (d.customer_id == null || (d.customer_id is string && d.customer_id.matches('^C[0-9]{5}$')))
        // 9) เลขบิลเป็นข้อความที่ไม่ว่าง
        && d.order_id is string && d.order_id.size() > 0;
    }
  }
}
