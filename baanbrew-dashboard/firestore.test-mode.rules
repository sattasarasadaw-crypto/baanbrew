rules_version = '2';
// ⚠️ โหมดทดสอบ: ใครก็อ่าน เขียน ลบได้หมด ใช้เฉพาะช่วง Lab 3.1–3.2 เท่านั้น
// Firebase console ตั้งให้อัตโนมัติเมื่อเลือก "Start in test mode" (มีวันหมดอายุ)
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
